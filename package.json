    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "astro": "^7.3.8",
    "astro-embed": "^0.14.0",
    "cheerio": "^1.2.0",
    "mermaid": "^12.2.0",
    "playwright": "^1.64.0",
    "rehype-mermaid": "^3.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-math": "^6.0.0",
    "remark-smartypants": "^3.0.3",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "starlight-showcases": "^0.3.2",
    "starlight-sidebar-topics": "^0.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5"
